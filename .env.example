# Neon Postgres
# Use the pooled connection for app runtime (hostname includes -pooler)
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&connect_timeout=15"

# Use the direct (non-pooler) connection for Prisma Migrate/CLI
DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
# Dedicated random key for hashing distributed rate-limit identities.
RATE_LIMIT_HMAC_SECRET="replace-with-a-distinct-long-random-secret"
# Set only when the deployment edge strips client-supplied forwarding headers
# and writes the canonical client address before forwarding to the application.
TRUST_PROXY_HEADERS="false"
# Separate random bearer credential for processing and operator cleanup endpoints.
PROCESSING_WORKER_TOKEN="replace-with-at-least-32-random-characters"

# Storage provider
# local: writes files to ./uploads
# s3: uses S3-compatible object storage (R2/S3/MinIO)
STORAGE_PROVIDER="local"

# S3-compatible storage settings (required when STORAGE_PROVIDER=s3)
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
# Must explicitly match the bucket setting in production. When true,
# deletion requires ListBucketVersions plus version/delete-marker deletion rights.
S3_OBJECT_VERSIONING_ENABLED="false"

# Video retention policy
# Uploaded video assets are temporary. Metrics remain durable.
VIDEO_RETENTION_HOURS="24"
KEEP_FAILED_VIDEOS_FOR_DEBUG="false"

# Upload limits
MAX_VIDEO_SIZE_MB="200"

# Computer-vision worker (required by the processing queue for local video storage)
VISION_PYTHON="./baseball_tracker/.venv/bin/python"
VISION_PERSON_MODEL="./baseball_tracker/yolov8n.pt"
VISION_POSE_MODEL="./yolov8n-pose.pt"
# Open-vocabulary baseline supports all canonical sports objects. Replace it
# with a validation-approved custom detector before professional release.
VISION_OBJECT_MODEL="./yolov8s-worldv2.pt"
# Apache-2.0 OpenCV Zoo YoutuReID baseline. Production workers verify the
# exact artifact hash documented in docs/cv-model-provenance.md.
VISION_REID_MODEL="./person_reid_youtu_2021nov_int8.onnx"
VISION_TIMEOUT_MS="120000"
